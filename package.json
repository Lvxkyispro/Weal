{
  "name": "admirin-you",
  "version": "1.0.0",
  "private": true,
  "description": "A mobile-first cinematic photo story. Built with Three.js and GSAP.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019,safari14 --outfile=assets/js/app.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2019,safari14 --outfile=assets/js/app.js --sourcemap --watch",
    "serve": "npx --yes serve -l 5173 ."
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "gsap": "3.15.0",
    "three": "0.186.1"
  }
}
